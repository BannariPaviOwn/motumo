# Razorpay Test Mode keys (Dashboard → Settings → API Keys → Generate Test Key)
# Never commit real secrets. Copy this file to `.env` for local development.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Public key for the browser Checkout.js widget (same Test Mode key id)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Optional: local payment API port (default 8787)
# RAZORPAY_API_PORT=8787
